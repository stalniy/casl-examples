{
  "name": "fastify-ucast-sql-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx --watch src/server.ts",
    "schema:mikro": "tsx src/schema.ts mikro",
    "seed:mikro": "tsx src/seed.ts mikro",
    "schema:typeorm": "tsx src/schema.ts typeorm",
    "seed:typeorm": "tsx src/seed.ts typeorm",
    "test": "node --import tsx --test spec/*.spec.ts",
    "test:express-contract": "node --import tsx spec/run-express-contract.cjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.0",
    "@ucast/mongo2js": "^2.0.0",
    "@ucast/sql": "file:vendor/ucast-sql-0.2.1.tgz",
    "@mikro-orm/core": "^7.0.0",
    "@mikro-orm/sqlite": "^7.0.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
