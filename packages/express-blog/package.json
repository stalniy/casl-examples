{
  "name": "blog-express",
  "version": "1.0.0",
  "private": true,
  "description": "Example of CASL and express integration",
  "main": "dist/index.js",
  "dependencies": {
    "@casl/ability": "^7.1.0",
    "@casl/mongoose": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-errors": "^1.6.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^9.6.1",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "bdd-lazy-var": "^2.6.0",
    "chai": "^4.2.0",
    "mocha": "^8.2.1",
    "typescript": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1"
  },
  "scripts": {
    "seed": "node src/seed.ts",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "test": "mocha -u bdd-lazy-var/getter -r spec/support.cjs --timeout 10000 spec/**/*.spec.cjs",
    "test:server": "mocha -u bdd-lazy-var/getter --timeout 10000 spec/**/*.spec.cjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prestart": "pnpm build",
    "pretest": "pnpm build",
    "pretest:server": "pnpm build"
  },
