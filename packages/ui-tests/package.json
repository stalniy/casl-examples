    "test.todo.dev": "playwright test --project=todo-app --headed",
    "test.blog": "playwright test --project=blog-app",
    "test.blog.react": "PLAYWRIGHT_APP=react-blog playwright test --project=blog-app",
    "test.blog.vue": "PLAYWRIGHT_APP=vue-blog playwright test --project=blog-app",
    "test.blog.dev": "playwright test --project=blog-app --headed"
  },
